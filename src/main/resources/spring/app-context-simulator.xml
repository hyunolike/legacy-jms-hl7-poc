<?xml version="1.0" encoding="UTF-8"?>
<!--
  병원 A 시뮬레이터용 컨텍스트.

  DLQ 도구와 같은 원칙으로 가볍게 유지한다.
    - 리스너를 띄우지 않는다. 시뮬레이터가 자기가 보낸 메시지를 가져가면 안 된다.
    - DB, 암복호화, SOAP 을 끌어오지 않는다. 메시지를 만들어 큐에 넣는 데는
      필요 없고, 브리지가 안 떠 있는 상태에서도 메시지를 쌓아 둘 수 있어야 한다.

  HAPI 컨텍스트는 필요하다. 샘플의 MSH-10 과 PID-3 를 바꿔 새 메시지를 만드는 데
  쓴다. 문자열 치환으로 때우면 필드 위치가 어긋났을 때 조용히 잘못된 메시지를
  만들어 낸다.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <import resource="app-context-common.xml"/>
    <import resource="app-context-jms-core.xml"/>

</beans>
