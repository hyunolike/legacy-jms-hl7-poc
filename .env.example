# ============================================================================
#  로컬 개발용 환경변수 예시.
#    cp .env.example .env   후 값을 채운다. .env 는 .gitignore 로 커밋이 막혀 있다.
#
#  운영에서는 이 파일 대신 키 관리 시스템(Vault, KMS, 사내 키스토어)에서 주입한다.
#  어떤 경우에도 키를 소스나 Spring properties 에 하드코딩하지 않는다.
# ============================================================================

# ── PostgreSQL (docker-compose 와 애플리케이션이 함께 참조) ──────────────────
POSTGRES_DB=hl7poc
POSTGRES_USER=hl7poc
POSTGRES_PASSWORD=hl7poc-local-only

# ── ActiveMQ ────────────────────────────────────────────────────────────────
HL7POC_BROKER_URL=tcp://localhost:61616
HL7POC_BROKER_USER=
HL7POC_BROKER_PASS=

# ── PHI 암호화 (secure 패키지) ──────────────────────────────────────────────
# 로컬 개발에서는 아래 두 키를 환경변수로 주입한다(EnvKeyProvider).
# 운영에서는 KeyStoreKeyProvider + JCEKS 키스토어를 쓴다.
#
# 32바이트 AES-256 키 생성:
#   openssl rand -base64 32
HL7POC_PHI_KEY_ID=k1
HL7POC_PHI_KEY=
# 환자 ID 블라인드 인덱스용 HMAC 키 (암호화 키와 반드시 분리한다)
HL7POC_BLIND_INDEX_KEY=

# ── 운영용 키스토어 방식을 쓸 때 ────────────────────────────────────────────
#HL7POC_KEYSTORE_PATH=/etc/hl7poc/phi-keys.jceks
#HL7POC_KEYSTORE_PASS=

# ── 병원 B SOAP 엔드포인트 ──────────────────────────────────────────────────
HL7POC_HOSPITAL_B_ENDPOINT=http://localhost:9090/hospital-b/admission
