<?xml version="1.0" encoding="UTF-8"?>
<!--
  루트 컨텍스트. 이 파일에는 빈을 정의하지 않고 import 만 한다.
  Main 은 이 파일 하나만 알면 된다.

  ※ import 순서는 "빈 정의를 읽는 순서"일 뿐, 기동 순서가 아니다.
    - 의존성은 참조로 해석되므로 순서와 무관하다.
    - 리스너 컨테이너는 모든 싱글턴이 만들어진 뒤 SmartLifecycle.start() 에서
      뜨므로, jms 를 앞에 둔다고 먼저 메시지를 받지 않는다.
    순서가 실제로 의미를 갖는 경우는 하나뿐이다: 같은 id 를 두 번 정의하면
    나중 것이 이긴다(테스트에서 스텁으로 갈아끼울 때 이 성질을 쓴다).

  Spring Boot 라면: 이 파일 자체가 없다. @SpringBootApplication 의 컴포넌트
  스캔과 auto-configuration 이 대신한다.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- 프로퍼티 치환, HL7 파서, 공통 유틸 -->
    <import resource="app-context-common.xml"/>

    <!-- DataSource, JdbcTemplate, 트랜잭션 매니저 -->
    <import resource="app-context-datasource.xml"/>

    <!-- PHI 암복호화, 키 공급자, 마스킹 -->
    <import resource="app-context-secure.xml"/>

    <!-- 병원 B SOAP 클라이언트 -->
    <import resource="app-context-ws.xml"/>

    <!-- ADT 업무 서비스, DAO, 트랜잭션 경계 -->
    <import resource="app-context-adt.xml"/>

    <!-- ConnectionFactory, 리스너 컨테이너, JmsTemplate -->
    <import resource="app-context-jms.xml"/>

</beans>
