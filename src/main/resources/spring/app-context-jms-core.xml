<?xml version="1.0" encoding="UTF-8"?>
<!--
  JMS 기반 설정: ConnectionFactory, 재전송 정책, 목적지, JmsTemplate.

  리스너 컨테이너와 분리한 이유는 운영 도구 때문이다. DLQ 재처리 도구는 브로커에
  붙어야 하지만 <b>요청 큐를 소비해서는 안 된다</b>. 같은 파일에 리스너가 들어
  있으면 도구를 띄우는 순간 컨슈머가 하나 더 붙어 메시지를 가져가 버린다.
  (그리고 도구가 PHI 암호화 키까지 있어야 뜨게 된다.)

    app-context-jms.xml          = core + listener   (브리지 본체)
    app-context-dlq-tool.xml     = core 만           (운영 도구)
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- ===================================================================
         1. ConnectionFactory
         =================================================================== -->

    <!--
      클라이언트측 재전송 정책. 2s → 4s → 8s 후 브로커가 DLQ 로 보낸다.

      ⚠ docker/activemq/activemq.xml 의 RedeliveryPlugin(현재 주석)과
        동시에 켜면 재시도가 곱해진다(3 × 3 = 최대 9회 처리). 브로커측으로
        옮길 때는 여기 maximumRedeliveries 를 0 으로 내려야 한다.

      클라이언트측의 단점: 재전송 대기 동안 그 컨슈머가 묶여 있다. 지연을 분
      단위로 길게 가져갈 거라면 브로커측 스케줄러가 맞다.
    -->
    <bean id="redeliveryPolicy" class="org.apache.activemq.RedeliveryPolicy">
        <property name="maximumRedeliveries"    value="${jms.redelivery.max}"/>
        <property name="initialRedeliveryDelay" value="${jms.redelivery.initialDelayMs}"/>
        <property name="redeliveryDelay"        value="${jms.redelivery.delayMs}"/>
        <property name="useExponentialBackOff"  value="true"/>
        <property name="backOffMultiplier"      value="${jms.redelivery.backOffMultiplier}"/>
        <property name="maximumRedeliveryDelay" value="${jms.redelivery.maxDelayMs}"/>
    </bean>

    <bean id="prefetchPolicy" class="org.apache.activemq.ActiveMQPrefetchPolicy">
        <property name="queuePrefetch" value="${jms.prefetch}"/>
    </bean>

    <!--
      원본 ConnectionFactory. 리스너 컨테이너와 트랜잭션 프록시가 "같은 인스턴스"를
      참조해야 한다. 스레드에 묶인 JMS 세션은 ConnectionFactory 인스턴스를 키로
      찾기 때문에, 여기를 두 벌로 만들면 ACK 가 리스너 트랜잭션에 합류하지 못한다.

      trustAllPackages 는 기본값(false)을 유지한다. 우리는 TextMessage 만 쓰므로
      ObjectMessage 역직렬화를 열어 줄 이유가 없다(역직렬화 RCE 경로 차단).
    -->
    <bean id="jmsConnectionFactory" class="org.apache.activemq.ActiveMQConnectionFactory">
        <property name="brokerURL"        value="${jms.broker.url}"/>
        <property name="userName"         value="${jms.broker.user}"/>
        <property name="password"         value="${jms.broker.password}"/>
        <property name="redeliveryPolicy" ref="redeliveryPolicy"/>
        <property name="prefetchPolicy"   ref="prefetchPolicy"/>
    </bean>

    <!--
      발행 전용 ConnectionFactory (세션/프로듀서 캐싱).
      리스너 트랜잭션 바깥에서 도는 것들 — 시뮬레이터, DLQ 재처리 도구 — 이 쓴다.
      리스너 컨테이너에는 절대 물리지 않는다. DMLC 는 자체 캐싱을 하므로
      CachingConnectionFactory 와 겹치면 세션 수명 관리가 어긋난다.
    -->
    <bean id="cachingConnectionFactory"
          class="org.springframework.jms.connection.CachingConnectionFactory">
        <property name="targetConnectionFactory" ref="jmsConnectionFactory"/>
        <property name="sessionCacheSize"        value="10"/>
        <property name="cacheProducers"          value="true"/>
    </bean>

    <!--
      트랜잭션 인지 ConnectionFactory.
      이걸 통해 발행한 ACK 는 리스너가 롤백하면 함께 사라진다 —
      "처리는 롤백됐는데 성공 ACK 만 나가는" 사고를 막는 장치다.

      동작 원리(실측으로 확인): 컨슈머의 세션을 함께 쓰는 것이 아니다.
      synchedLocalTransactionAllowed=true 이면, 현재 스레드에 활성 스프링
      트랜잭션(여기서는 DMLC 가 연 DB 트랜잭션)이 있을 때 별도의 JMS 세션을
      만들고 그 세션의 commit/rollback 을 DB 트랜잭션의 완료 시점에 묶는다.
      즉 동기화의 기준점은 "컨슈머 세션"이 아니라 "DB 트랜잭션"이다.
      그래서 리스너 컨테이너의 cacheLevel 과 무관하게 성립한다.

      다만 ACK 세션 커밋은 DB 커밋 "이후"다. 그 사이에 죽으면 DB 는 커밋됐는데
      ACK 는 안 나간 상태가 된다. 이 경우 상대가 재전송하고, 멱등성 테이블에
      저장해 둔 ACK 를 그대로 되돌려준다(docs/01 4.1절).
    -->
    <bean id="transactionAwareConnectionFactory"
          class="org.springframework.jms.connection.TransactionAwareConnectionFactoryProxy">
        <property name="targetConnectionFactory"       ref="jmsConnectionFactory"/>
        <property name="synchedLocalTransactionAllowed" value="true"/>
    </bean>

    <!-- ===================================================================
         2. 목적지
         =================================================================== -->

    <bean id="adtRequestQueue" class="org.apache.activemq.command.ActiveMQQueue">
        <constructor-arg value="${jms.queue.adtRequest}"/>
    </bean>
    <bean id="adtAckQueue" class="org.apache.activemq.command.ActiveMQQueue">
        <constructor-arg value="${jms.queue.adtAck}"/>
    </bean>
    <bean id="adtParkQueue" class="org.apache.activemq.command.ActiveMQQueue">
        <constructor-arg value="${jms.queue.adtPark}"/>
    </bean>
    <bean id="adtDlqQueue" class="org.apache.activemq.command.ActiveMQQueue">
        <constructor-arg value="${jms.queue.adtDlq}"/>
    </bean>

    <!-- ===================================================================
         3. JmsTemplate
         =================================================================== -->

    <!--
      리스너 안에서 쓰는 템플릿. ACK 발행과 PARK 큐 격리 모두 이걸 쓴다.
      sessionTransacted=true 여야 트랜잭션 인지 프록시가 세션 합류를 시도한다.
    -->
    <bean id="jmsTemplate" class="org.springframework.jms.core.JmsTemplate">
        <property name="connectionFactory"  ref="transactionAwareConnectionFactory"/>
        <property name="sessionTransacted"  value="true"/>
        <property name="explicitQosEnabled" value="true"/>
        <property name="deliveryPersistent" value="true"/>
        <property name="receiveTimeout"     value="${jms.receiveTimeoutMs}"/>
    </bean>

    <!--
      리스너 바깥(시뮬레이터, DLQ 재처리)에서 쓰는 템플릿.
      합류할 트랜잭션이 없으므로 캐싱 팩토리를 그대로 쓴다.
    -->
    <bean id="standaloneJmsTemplate" class="org.springframework.jms.core.JmsTemplate">
        <property name="connectionFactory"  ref="cachingConnectionFactory"/>
        <property name="explicitQosEnabled" value="true"/>
        <property name="deliveryPersistent" value="true"/>
        <property name="receiveTimeout"     value="${jms.receiveTimeoutMs}"/>
    </bean>

</beans>
