<?xml version="1.0" encoding="UTF-8"?>
<!--
  5단계 업무 계층 검증용 컨텍스트.

  운영 XML 세 개(datasource / secure / adt)를 그대로 import 한다. 복사본을 만들면
  검증한 설정과 실제로 도는 설정이 갈라져 검증이 의미를 잃는다.

  병원 B 연동만 가짜로 바꾼다(6단계 산출물). 테스트가 성공/일시실패/영구실패를
  지정할 수 있어야 롤백 경로를 볼 수 있다.

  암호화 키는 테스트가 System.setProperty 로 주입한다. PropertySourcesPlaceholderConfigurer
  는 시스템 프로퍼티도 보므로 ${HL7POC_PHI_KEY:} 가 그대로 해석된다.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <context:property-placeholder
            location="classpath:config/hl7poc.properties"
            file-encoding="UTF-8"/>

    <import resource="classpath:spring/app-context-datasource.xml"/>
    <import resource="classpath:spring/app-context-secure.xml"/>
    <import resource="classpath:spring/app-context-adt.xml"/>

    <bean id="hospitalBNotifier" class="com.example.hl7poc.support.FakeHospitalBNotifier"/>

</beans>
