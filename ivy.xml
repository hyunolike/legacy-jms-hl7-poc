<?xml version="1.0" encoding="UTF-8"?>
<ivy-module version="2.0">

    <info organisation="com.example"
          module="hl7-adt-bridge"
          revision="0.1.0"
          status="integration"/>

    <configurations>
        <conf name="compile" description="컴파일과 런타임 모두에 필요"/>
        <conf name="runtime" extends="compile" description="런타임에만 필요(드라이버 등)"/>
        <conf name="test"    extends="runtime" description="테스트 전용"/>
    </configurations>

    <dependencies>

        <!-- ── Spring Framework 5.3.x (XML 설정 전용) ──────────────────────
             spring-context 가 core/beans/aop/expression 을 끌어온다.
             spring-jdbc 가 spring-tx 를 끌어온다.
             Spring Boot 라면 starter 3개(activemq/jdbc)로 끝날 자리다. -->
        <dependency org="org.springframework" name="spring-context" rev="5.3.39" conf="compile->default"/>
        <dependency org="org.springframework" name="spring-jms"     rev="5.3.39" conf="compile->default"/>
        <dependency org="org.springframework" name="spring-jdbc"    rev="5.3.39" conf="compile->default"/>

        <!-- ── ActiveMQ Classic 5.18 클라이언트 ────────────────────────────
             javax.jms API 는 jakarta.jms-api 2.0.3 으로 전이 의존된다.
             (2.0.3 까지는 패키지명이 javax.jms 그대로다. 따로 javax.jms-api 를
              선언하면 클래스가 중복되므로 선언하지 않는다.)
             activemq-openwire-legacy 는 구버전 OpenWire 마셜러로, 5.18 에서는
             별도 아티팩트라 명시적으로 넣어 준다. -->
        <dependency org="org.apache.activemq" name="activemq-client"          rev="5.18.6" conf="compile->default"/>
        <dependency org="org.apache.activemq" name="activemq-openwire-legacy" rev="5.18.6" conf="runtime->default"/>

        <!-- ── HAPI HL7 v2 파서 ────────────────────────────────────────────
             hapi-base = 파서/검증 엔진, hapi-structures-v25 = v2.5 메시지 구조체.
             다른 HL7 버전을 다루려면 해당 structures 아티팩트를 추가한다. -->
        <dependency org="ca.uhn.hapi" name="hapi-base"           rev="2.3" conf="compile->default"/>
        <dependency org="ca.uhn.hapi" name="hapi-structures-v25" rev="2.3" conf="compile->default"/>

        <!-- ── JAX-WS (병원 B mock SOAP 서버 + 클라이언트) ─────────────────
             Java 11 부터 JDK 에서 JAX-WS 가 제거되었으므로 직접 의존해야 한다.
             jaxws-rt 는 전이 의존이 많다(JAXB, StAX, saaj 등). -->
        <dependency org="com.sun.xml.ws" name="jaxws-rt" rev="2.3.7" conf="compile->default"/>

        <!-- ── DB ─────────────────────────────────────────────────────────
             컴파일 시점에는 JDBC 표준 API 만 쓰므로 드라이버는 runtime 으로 충분하다.
             커넥션 풀은 commons-dbcp2. 이 시대 레거시에서 가장 흔했고, XML 설정만으로
             풀 파라미터를 전부 노출한다. 풀 크기는 maxConcurrentConsumers 보다 커야
             한다(app-context-datasource.xml 주석 참고). -->
        <dependency org="org.postgresql"     name="postgresql"    rev="42.7.4" conf="runtime->default"/>
        <dependency org="org.apache.commons" name="commons-dbcp2" rev="2.9.0"  conf="compile->default"/>

        <!-- ── AOP ────────────────────────────────────────────────────────
             <aop:config> 의 AspectJ 포인트컷 표현식을 파싱하려면 aspectjweaver 가
             필요하다(위빙은 하지 않는다. 표현식 파서만 쓴다).
             1.9.21 까지가 Java 8 을 지원한다. -->
        <dependency org="org.aspectj" name="aspectjweaver" rev="1.9.21" conf="runtime->default"/>

        <!-- ── 로깅 ───────────────────────────────────────────────────────
             activemq-client 5.18.6 이 slf4j 2.0 에 맞춰 빌드되어 있어, 1.7.x 를
             선언해도 충돌 해소 과정에서 2.0 이 올라온다. 1.7 로 강제로 내리면
             ActiveMQ 가 slf4j 2 전용 메서드를 부를 때 NoSuchMethodError 가 난다.
             그래서 반대 방향으로 맞춘다: slf4j 2.0 + logback 1.3.x.
             (logback 1.3.x 는 Java 8 을 계속 지원한다. Java 11 이상이 필요한 것은
              1.4.x 부터다.)

             commons-logging 브리지는 따로 넣지 않는다. spring-jcl 이 이미
             org.apache.commons.logging.* 를 제공하며 slf4j 로 위임하므로,
             jcl-over-slf4j 를 함께 넣으면 같은 클래스가 두 jar 에서 나온다. -->
        <dependency org="org.slf4j"      name="slf4j-api"       rev="2.0.13" conf="compile->default"/>
        <dependency org="ch.qos.logback" name="logback-classic" rev="1.3.14" conf="runtime->default"/>

        <!-- ── 테스트 ─────────────────────────────────────────────────────
             activemq-broker 는 통합 테스트용 임베디드(vm://) 브로커. -->
        <dependency org="junit"               name="junit"            rev="4.13.2" conf="test->default"/>
        <dependency org="org.mockito"         name="mockito-core"     rev="4.11.0" conf="test->default"/>
        <dependency org="org.springframework" name="spring-test"      rev="5.3.39" conf="test->default"/>
        <dependency org="org.apache.activemq" name="activemq-broker"  rev="5.18.6" conf="test->default"/>
        <dependency org="org.apache.activemq" name="activemq-kahadb-store" rev="5.18.6" conf="test->default"/>

        <!-- spring-context 가 끌고 오는 commons-logging 은 jcl-over-slf4j 와 충돌한다. -->
        <exclude org="commons-logging" module="commons-logging"/>

    </dependencies>

</ivy-module>
