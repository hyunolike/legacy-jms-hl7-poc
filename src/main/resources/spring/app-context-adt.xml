<?xml version="1.0" encoding="UTF-8"?>
<!--
  adt: 업무 서비스와 DAO, 그리고 트랜잭션 경계.
  condb-secure 의 condb 계층에 대응한다. (구현은 5단계)
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:aop="http://www.springframework.org/schema/aop"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/aop
           http://www.springframework.org/schema/aop/spring-aop.xsd
           http://www.springframework.org/schema/tx
           http://www.springframework.org/schema/tx/spring-tx.xsd">

    <!-- ===================================================================
         DAO
         =================================================================== -->

    <bean id="processedMessageDao"
          class="com.example.hl7poc.adt.dao.ProcessedMessageDaoJdbc">
        <constructor-arg ref="jdbcTemplate"/>
    </bean>

    <bean id="adtMessageDao"
          class="com.example.hl7poc.adt.dao.AdtMessageDaoJdbc">
        <constructor-arg ref="jdbcTemplate"/>
    </bean>

    <bean id="processingLogDao"
          class="com.example.hl7poc.adt.dao.ProcessingLogDaoJdbc">
        <constructor-arg ref="jdbcTemplate"/>
    </bean>

    <!-- ===================================================================
         서비스
         =================================================================== -->

    <bean id="adtProcessingService"
          class="com.example.hl7poc.adt.service.AdtProcessingServiceImpl">
        <constructor-arg ref="processedMessageDao"/>
        <constructor-arg ref="adtMessageDao"/>
        <constructor-arg ref="processingLogDao"/>
        <constructor-arg ref="phiCipher"/>
        <constructor-arg ref="blindIndex"/>
        <constructor-arg ref="hospitalBNotifier"/>
    </bean>

    <!-- ===================================================================
         트랜잭션 경계

         리스너 경로에서는 DMLC 가 이미 트랜잭션을 열어 두므로, 아래 advice 는
         REQUIRED 로 "합류"만 한다(중첩 트랜잭션이 생기지 않는다).
         이 advice 가 필요한 이유는 JMS 를 거치지 않는 경로 때문이다.
           - DLQ 재처리 도구가 서비스를 직접 호출할 때
           - 테스트가 서비스를 직접 호출할 때
         이 경로들에는 DMLC 가 없으므로 여기서 트랜잭션을 열어 줘야 한다.

         rollback-for 를 명시하는 이유: Spring 기본값은 RuntimeException 과
         Error 에만 롤백한다. 체크 예외를 쓰는 레거시 코드에서 "예외는 났는데
         커밋은 됐다"가 여기서 나온다. 우리 예외 계층을 명시적으로 적는다.

         Spring Boot 라면: @Transactional(rollbackFor=...) 한 줄. 동작은 같다.
         =================================================================== -->

    <tx:advice id="adtTxAdvice" transaction-manager="transactionManager">
        <tx:attributes>
            <!-- 조회는 읽기 전용으로 열어 DB 최적화 힌트를 준다. -->
            <tx:method name="find*"   propagation="REQUIRED" read-only="true"/>
            <tx:method name="get*"    propagation="REQUIRED" read-only="true"/>
            <tx:method name="exists*" propagation="REQUIRED" read-only="true"/>
            <!--
              no-rollback-for 가 이 설정의 핵심이다.

              PermanentProcessingException 은 "재시도해도 소용없다"는 뜻이고,
              리스너는 이걸 받으면 격리 큐로 옮기고 AE 를 보낸 뒤 정상 커밋한다.
              그런데 이 advice 가 예외를 보고 트랜잭션을 rollback-only 로 표시해
              버리면, 리스너가 이어서 하는 격리 기록과 ACK 기록이 통째로 사라지고
              커밋 시점에 UnexpectedRollbackException 이 난다. 결과적으로 메시지는
              재전송되고 DLQ 로 간다 — 우리가 명시적으로 "재시도 무의미"라고
              분류한 오류인데도.

              종단 간 테스트(상대가_업무적으로_거절하면_재시도하지_않고_격리한다)가
              이 문제를 잡았다. 계층별 테스트로는 드러나지 않는다. 트랜잭션을 여는
              쪽(DMLC)과 예외를 분류하는 쪽(리스너)과 예외를 던지는 쪽(서비스)이
              모두 달라야 재현되기 때문이다.

              TransientProcessingException 은 반대로 반드시 롤백되어야 하므로
              기본 동작(RuntimeException 롤백)을 그대로 둔다.
            -->
            <tx:method name="*"
                       propagation="REQUIRED"
                       isolation="READ_COMMITTED"
                       timeout="30"
                       rollback-for="java.lang.Exception"
                       no-rollback-for="com.example.hl7poc.common.exception.PermanentProcessingException"/>
        </tx:attributes>
    </tx:advice>

    <aop:config>
        <aop:pointcut id="adtServiceMethods"
                      expression="execution(* com.example.hl7poc.adt.service.*Service.*(..))"/>
        <aop:advisor advice-ref="adtTxAdvice" pointcut-ref="adtServiceMethods"/>
    </aop:config>

</beans>
